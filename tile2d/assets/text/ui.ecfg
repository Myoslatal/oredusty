# Interface strings of the game shell, one table per language.
#
# These are the engine shell's own labels (the start screen and the session screen). The game's own
# content strings arrive later, from the designer, in their own file.
#
# Ids are stable: a save or a log refers to an id, never to the text, so the text can be reworded or
# retranslated at any time.

en::
    title:"MINE"
    subtitle:"SANDBOX / INDUSTRIAL AUTOMATION"
    row.world:"WORLD"
    row.language:"LANGUAGE"
    row.seed:"SEED"
    row.start:"START SINGLE PLAYER"
    row.host:"HOST A GAME"
    row.join:"JOIN A GAME"
    row.quit:"QUIT"
    value.story:"STORY"
    value.endless:"ENDLESS"
    hint.rows:"UP/DOWN SELECT   LEFT/RIGHT CHANGE"
    hint.actions:"ENTER CONFIRM   R RANDOM SEED   ESC QUIT"
    seed.hint:"SEED {} - PRESS R TO RANDOMISE"
    session.title:"SESSION"
    session.world:"WORLD"
    session.role:"ROLE"
    session.seed:"SEED"
    session.content:"CONTENT"
    session.connect:"CONNECT"
    session.pending:"LAYER CONTENT: NOT AUTHORED YET"
    session.pending.line1:"RESOURCES, STRUCTURES AND DEMANDS COME FROM THE"
    session.pending.line2:"DESIGNER DATA (docs/GAME_DESIGN.md SECTION 7)."
    session.back:"ESC BACK TO THE START SCREEN"
    content.registered:"{} REGISTERED"
    role.single:"SINGLE"
    role.host:"HOST"
    role.join:"JOIN"

