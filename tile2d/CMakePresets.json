{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "mine-common",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "T2D_BUILD_MINE": "ON",
        "T2D_BUILD_MEFEMMA": "OFF"
      }
    },
    {
      "name": "mine-debug",
      "inherits": "mine-common",
      "displayName": "Mine - Debug",
      "binaryDir": "${sourceDir}/build/mine/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "mine-release",
      "inherits": "mine-common",
      "displayName": "Mine - Release",
      "binaryDir": "${sourceDir}/build/mine/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "mine-asan",
      "inherits": "mine-common",
      "displayName": "Mine - Debug + Address/UB sanitizers",
      "binaryDir": "${sourceDir}/build/mine/asan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "T2D_ENABLE_SANITIZERS": "ON",
        "T2D_WARNINGS_AS_ERRORS": "OFF"
      }
    },
    {
      "name": "mine-tsan",
      "inherits": "mine-common",
      "displayName": "Mine - Debug + ThreadSanitizer",
      "binaryDir": "${sourceDir}/build/mine/tsan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "T2D_ENABLE_THREAD_SANITIZER": "ON",
        "T2D_WARNINGS_AS_ERRORS": "OFF"
      }
    },
    {
      "name": "mefemma-common",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "T2D_BUILD_MINE": "OFF",
        "T2D_BUILD_MEFEMMA": "ON"
      }
    },
    {
      "name": "mefemma-debug",
      "inherits": "mefemma-common",
      "displayName": "Mefemma - Debug",
      "binaryDir": "${sourceDir}/build/mefemma/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "mefemma-release",
      "inherits": "mefemma-common",
      "displayName": "Mefemma - Release",
      "binaryDir": "${sourceDir}/build/mefemma/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "mefemma-asan",
      "inherits": "mefemma-common",
      "displayName": "Mefemma - Debug + Address/UB sanitizers",
      "binaryDir": "${sourceDir}/build/mefemma/asan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "T2D_ENABLE_SANITIZERS": "ON",
        "T2D_WARNINGS_AS_ERRORS": "OFF"
      }
    },
    {
      "name": "mefemma-tsan",
      "inherits": "mefemma-common",
      "displayName": "Mefemma - Debug + ThreadSanitizer",
      "binaryDir": "${sourceDir}/build/mefemma/tsan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "T2D_ENABLE_THREAD_SANITIZER": "ON",
        "T2D_WARNINGS_AS_ERRORS": "OFF"
      }
    },
    {
      "name": "no-renderer",
      "displayName": "Framework - no renderer or game",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/no-renderer",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_BUILD_TYPE": "Release",
        "T2D_BUILD_MINE": "OFF",
        "T2D_BUILD_MEFEMMA": "OFF",
        "T2D_BUILD_TESTS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "mine-debug",
      "configurePreset": "mine-debug"
    },
    {
      "name": "mine-release",
      "configurePreset": "mine-release"
    },
    {
      "name": "mine-asan",
      "configurePreset": "mine-asan"
    },
    {
      "name": "mine-tsan",
      "configurePreset": "mine-tsan"
    },
    {
      "name": "mefemma-debug",
      "configurePreset": "mefemma-debug"
    },
    {
      "name": "mefemma-release",
      "configurePreset": "mefemma-release"
    },
    {
      "name": "mefemma-asan",
      "configurePreset": "mefemma-asan"
    },
    {
      "name": "mefemma-tsan",
      "configurePreset": "mefemma-tsan"
    },
    {
      "name": "no-renderer",
      "configurePreset": "no-renderer"
    }
  ],
  "testPresets": [
    {
      "name": "mine-debug",
      "configurePreset": "mine-debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "mine-release",
      "configurePreset": "mine-release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "mine-tsan",
      "configurePreset": "mine-tsan",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "mefemma-debug",
      "configurePreset": "mefemma-debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "mefemma-release",
      "configurePreset": "mefemma-release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "mefemma-tsan",
      "configurePreset": "mefemma-tsan",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
