# A pack that requires another one. Its file name sorts *before* the pack it needs, so this file is
# also the test that the load order comes from "requires" and not from the directory listing.
pack::
    id:"dependent_pack"
    name:"Depends on base_pack"
    version:"1.0"
    requires:["base_pack"]
structure::
    pack_tower::
machine::
    pack_lift::
