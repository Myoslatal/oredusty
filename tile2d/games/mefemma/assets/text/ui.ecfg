# Interface strings of Mefemma's start screen and its example scenes, one table per language.
#
# Text is looked up by id, never stored in code: a language is a table, and a missing string shows its id
# (a visible failure) instead of an empty label. A game adds its own ids here or in its own table.
#
# Ids are stable: a log refers to an id, never to the text, so the text can be reworded at any time.

en::
    start.title:"MEFEMMA"
    start.new_game:"NEW GAME"
    start.load_game:"SAVE LIST"
    start.settings:"SETTINGS"
    start.mods:"MODS"
    start.quit:"QUIT GAME"
    start.hint:"UP/DOWN SELECT   ENTER CONFIRM   F2 LANGUAGE   ESC QUIT"
    start.not_implemented:"THIS FEATURE IS NOT IMPLEMENTED YET"
    start.back:"PRESS ESC OR ENTER TO RETURN"
    settings.title:"SETTINGS"
    settings.language:"LANGUAGE"
    settings.back:"BACK"
    settings.hint:"UP/DOWN SELECT   LEFT/RIGHT CHANGE   ENTER CHANGE   ESC BACK"
    savepath.title:"SAVE LOCATION"
    savepath.prompt:"WHERE SHOULD MEFEMMA KEEP ITS SAVE FILES?"
    savepath.hint:"TYPE A FOLDER   ENTER CONFIRM   ESC QUIT"
    savepath.error.empty:"A SAVE FOLDER IS REQUIRED"
    savepath.error.failed:"NOT USABLE: {}"
    play.title:"PLAYGROUND"
    play.note:"THIS SCENE IS YOURS TO REPLACE"
    play.hint:"WASD / ARROWS PAN   WHEEL OR +/- ZOOM   C CENTRE   ESC BACK"
    play.cell:"WORLD {:.0f}, {:.0f}   CELL {}, {}"
    play.pointer.outside:"POINTER OUTSIDE THE WINDOW"
    ow.title:"OPEN WORLD - TWO TEST TILES, TWO TEST CHUNKS"
    ow.note:"CHUNK 0,0 LEADS WITH TILE A, CHUNK 1,0 WITH TILE B; BOTH FROM test_tiles.png"
    ow.hint:"LMB CYCLE A/B/EMPTY   1/2/0 PLACE A/B/EMPTY   S SAVE   C CENTRE   ESC SAVE+BACK   ARROWS/W A D PAN   WHEEL ZOOM"
    ow.chunk:"CHUNK {},{}"
    ow.cell:"CELL {}, {}   TILE {}"
    ow.tile.a:"A"
    ow.tile.b:"B"
    ow.tile.empty:"EMPTY"
    ow.pointer.outside:"POINTER OUTSIDE THE WINDOW"
    ow.chunks:"{} CHUNK(S) LOADED   {} DIRTY   ORIGIN CHUNK {}, {}"
    ow.store:"STORE {}"
    ow.store.error:"STORE ERROR: {}"
    ow.save.none:"NOT SAVED YET"
    ow.save.ok:"SAVED   {} CHUNK(S) IN STORE"
    ow.save.failed:"SAVE FAILED"
    ow.save.failed.reason:"SAVE FAILED: {}"
    debug.line:"{:.0f} FPS   {:.2f} MS   {} DRAW CALL(S)   {} SCENE(S)   F1 HIDE"
    debug.missing:"{} PICTURE(S) MISSING"

