// Ore framework - build configuration. Generated by CMake from include/ore/config.h.in.
#pragma once

#define ORE_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define ORE_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define ORE_VERSION_PATCH @PROJECT_VERSION_PATCH@
#define ORE_VERSION_STRING "@PROJECT_VERSION@"

#cmakedefine01 ORE_ENABLE_VALIDATION
#cmakedefine01 ORE_ENABLE_SHADERC
#cmakedefine01 ORE_ENABLE_HOT_RELOAD
#cmakedefine01 ORE_ENABLE_ZLIB
#cmakedefine01 ORE_ENABLE_SANITIZERS
#cmakedefine01 ORE_PLATFORM_LINUX
#cmakedefine01 ORE_PLATFORM_WINDOWS
#cmakedefine01 ORE_PLATFORM_MACOS

/// 1 for builds with assertions and validation enabled, 0 for NDEBUG builds.
#if defined(NDEBUG)
#define ORE_DEBUG_BUILD 0
#else
#define ORE_DEBUG_BUILD 1
#endif
