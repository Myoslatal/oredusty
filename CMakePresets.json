{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "ORE_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "debug",
      "inherits": "base",
      "displayName": "Debug + validation layers",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "ORE_ENABLE_VALIDATION": "ON" }
    },
    {
      "name": "release",
      "inherits": "base",
      "displayName": "Release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "ORE_ENABLE_VALIDATION": "OFF" }
    },
    {
      "name": "asan",
      "inherits": "base",
      "displayName": "Debug + AddressSanitizer/UBSan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ORE_ENABLE_SANITIZERS": "ON",
        "ORE_WARNINGS_AS_ERRORS": "OFF"
      }
    },
    {
      "name": "embedded",
      "inherits": "debug",
      "displayName": "Debug with SPIR-V embedded into the binary",
      "cacheVariables": { "ORE_EMBED_SHADERS": "ON" }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" },
    { "name": "asan", "configurePreset": "asan" },
    { "name": "embedded", "configurePreset": "embedded" }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error", "stopOnFailure": false }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": { "outputOnFailure": true }
    }
  ]
}
